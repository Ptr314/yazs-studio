; SPDX-License-Identifier: GPL-3.0-or-later
; Part of the YAZS Studio project: https://github.com/Ptr314/yazs-studio
;
; Движок .YZ (docs/FORMAT.md). Тот же расчет, что в pyplay.py, - модель на Python
; проверяет его по регистрам ячейки тик за тиком.

; --- Начало мелодии: файл загружен, .YZ с адреса YZ ---
eng_start   lda YZ+67
            sta speed
            lda YZ+66
            sta ntimer
            jsr set_timer
            lda YZ+2
            sta yzver
            lda #$FF
            sta loopf
            sta loopfh
            lda yzver
            cmp #2
            bcs es_v2
            lda YZ+68
            sta frames
            lda #0
            sta framesh
            lda YZ+3
            and #1
            beq es_noloop
            lda YZ+69
            sta loopf
            lda #0
            sta loopfh
            beq es_noloop
            ; v2: число кадров и кадр повтора - 16 бит
es_v2       lda YZ+80
            sta frames
            lda YZ+81
            sta framesh
            lda YZ+3
            and #1
            beq es_noloop
            lda YZ+82
            sta loopf
            lda YZ+83
            sta loopfh
es_noloop   lda loopf           ; кадр повтора заголовка (loopf включает интерфейс, R)
            sta hloop
            lda loopfh
            sta hlooph
            jsr map_main
            ldx #0
es_ptr      lda YZ+70,x         ; смещения таблиц -> адреса
            sta ordp,x
            lda YZ+71,x
            clc
            adc #hi(YZ)
            sta ordp+1,x
            inx
            inx
            cpx #8
            bne es_ptr
            ldx #7
es_ch       lda #0
            sta c_ins,x
            sta c_pend,x
            sta c_state,x
            sta c_delay,x
            sta c_cut,x
            sta c_cutreq,x
            sta c_porta,x
            sta c_slide,x
            sta c_arpfx,x
            sta c_vibfx,x
            sta c_det,x
            sta c_trem,x
            sta c_trans,x
            sta c_retrig,x
            sta c_lreg,x
            sta c_meter,x
            sta c_wait,x
            sta c_pdirty,x
            lda #$FF
            sta c_pins,x
            sta c_bus,x
            sta c_lperlo,x
            sta c_lperhi,x
            sta c_uins,x
            sta c_unote,x
            sta c_ureg,x
            sta c_umeter,x
            dex
            bpl es_ch
            lda #$FF
            sta d_pend
            sta d_pend+1
            sta jump
            sta jumph
            sta text
            lda #0
            sta d_preset
            sta d_preset+1
            sta tick
            sta brkf
            sta ended
            sta tcnt
            sta tcnt+1
            sta secacc
            sta secacc+1
            sta secs
            sta secs+1
            sta tail
            lda #1
            sta textchg
            lda #$FF
            sta idlemin
            sta idlemin+1
            lda #0
            sta idle
            sta idle+1
            tay
            jmp load_frame

; --- Кадр A (младший) / Y (старший): число строк, указатели и банки паттернов ---
; Время - место в мелодии: время входа в кадр берется из таблицы (ft_build), так
; что переход по кадрам, повтор и JUMP показывают место, а не счет от начала игры.
; Без таблицы при входе в кадр повтора заголовка время запоминается (ltime): при
; повторе оно вернется, и часы покажут место в мелодии, а не бесконечный счет
load_frame  sta frame
            sty frameh
            ldx ftok
            beq lf_old
            asl a               ; zt = ftabpg:$FC + 4 * кадр (кадров < $4000)
            sta zt
            tya
            rol a
            asl zt
            rol a
            tax
            lda zt
            clc
            adc #$FC
            sta zt
            txa
            adc ftabpg
            sta zt+1
            ldy ftbank          ; окно - на банк таблицы (parse_ch вернет свой)
            sta MAPWIN,y
            sty curbank
            ldy #3              ; secacc (2) и secs (2) идут подряд
lf_tt       lda (zt),y
            sta secacc,y
            dey
            bpl lf_tt
            bmi lf_fr
lf_old      cmp hloop
            bne lf_nl
            cpy hlooph
            bne lf_nl
            ldx #3
lf_t        lda secacc,x
            sta ltime,x
            dex
            bpl lf_t
lf_fr       lda frame
            ldy frameh
lf_nl       jsr frame_ptr
            ldy #0
            lda (zt),y
            sta frows
            lda #0
            sta t0              ; канал
lf_ch       ldy t0
            jsr pat_ptr
            ldx t0
            sta c_bank,x
            lda #0
            sta c_wait,x
            txa
            asl a
            tax
            lda tmp16
            sta patp,x
            lda tmp16+1
            sta patp+1,x
            inc t0
            lda t0
            cmp #8
            bne lf_ch
            lda #0
            sta row
            rts

; zt = запись кадра A (младший) / Y (старший): ordp + 9 * кадр (v1), 17 * кадр (v2)
frame_ptr   sta t0
            sty t1
            sta t2
            sty t3
            ldx #3
fp_1        asl t2
            rol t3
            dex
            bne fp_1
            lda yzver
            cmp #2
            bcc fp_9
            asl t2
            rol t3
fp_9        lda t2
            clc
            adc t0
            sta t2
            lda t3
            adc t1
            sta t3
            lda t2
            clc
            adc ordp
            sta zt
            lda t3
            adc ordp+1
            sta zt+1
            rts

; Паттерн канала Y кадра (zt): адрес в tmp16, банк в A. v1 - номер байтом,
; в таблице смещение (2 байта); v2 - номер 2 байтами, в таблице смещение и блок:
; 0 - основная часть (от YZ), 1-8 - блок в окне (банк 8-15)
pat_ptr     lda yzver
            cmp #2
            bcs pp_v2
            iny
            lda (zt),y
            asl a
            sta t3
            lda #0
            rol a
            sta t1
            lda ptabp
            clc
            adc t3
            sta tmp16
            lda ptabp+1
            adc t1
            sta tmp16+1
            lda #MAINBANK
            sta t3
            lda #hi(YZ)
            bne pp_set
pp_v2       tya
            asl a
            tay
            iny
            lda (zt),y
            sta t3
            iny
            lda (zt),y
            sta t1
            ; tmp16 = ptabp + 3 * номер
            lda t3
            asl a
            sta tmp16
            lda t1
            rol a
            sta tmp16+1
            lda tmp16
            clc
            adc t3
            sta tmp16
            lda tmp16+1
            adc t1
            sta tmp16+1
            lda tmp16
            clc
            adc ptabp
            sta tmp16
            lda tmp16+1
            adc ptabp+1
            sta tmp16+1
            ldy #2
            lda (tmp16),y
            beq pp_main
            clc
            adc #7
            sta t3
            lda #hi(WINDOW)
            bne pp_set
pp_main     lda #MAINBANK
            sta t3
            lda #hi(YZ)
pp_set      sta t1              ; база: YZ или окно
            ldy #0
            lda (tmp16),y
            pha
            iny
            lda (tmp16),y
            clc
            adc t1
            sta tmp16+1
            pla
            sta tmp16
            lda t3
            rts

; --- Байт потока канала ch ---
getb        ldx ch2
            lda (patp,x)
            inc patp,x
            bne gb_1
            inc patp+1,x
gb_1        ldx ch
            rts

; --- Тик ---
eng_tick    lda ended
            beq et_go
            jmp et_tail
et_go       lda tick
            bne et_tones
            ldx #0
et_parse    stx ch
            txa
            asl a
            sta ch2
            jsr parse_ch
            ldx ch
            inx
            cpx #8
            bne et_parse
            ; Ударный, который ударит в тике 1: сейчас D4 = 0
            ldx #5
            jsr drum_prep
            ldx #6
            jsr drum_prep
et_tones    ldx #0
et_tl       stx ch
            jsr tone_tick
            ldx ch
            inx
            cpx #5
            bne et_tl
            lda tick
            cmp #1
            bne et_adv
            ldx #5
            jsr drum_hit
            ldx #6
            jsr drum_hit
et_adv      inc tcnt
            bne et_a1
            inc tcnt+1
et_a1       jsr count_secs
            inc tick
            lda tick
            cmp speed
            bcc et_done
            lda #0
            sta tick
            inc row
            lda brkf
            bne et_next
            lda jumph
            cmp #$FF
            bne et_next
            lda row
            cmp frows
            bcc et_done
et_next     lda jumph
            cmp #$FF
            beq et_inc
            ldy jumph           ; переход на кадр jump
            lda jump
            jmp et_jmp
et_inc      lda frame
            clc
            adc #1
            pha
            lda frameh
            adc #0
            tay
            pla
et_jmp      ldx #$FF
            stx jump
            stx jumph
            ldx #0
            stx brkf
            ; A/Y - новый кадр: дальше последнего - повтор или конец
            cpy framesh
            bcc et_lf
            bne et_over
            cmp frames
            bcc et_lf
et_over     lda loopfh
            cmp #$FF
            beq et_end
            ldx #3              ; время - как при первом входе в кадр повтора
et_lt       lda ltime,x
            sta secacc,x
            dex
            bpl et_lt
            lda loopf
            ldy loopfh
et_lf       jmp load_frame
et_end      lda #1
            sta ended
et_done     rts
            ; После конца - секунда на отпускание нот
et_tail     ldx #0
et_tt       stx ch
            lda c_state,x
            cmp #1
            bne et_tt1
            lda #2
            sta c_state,x
            lda #0
            sta c_regpos,x
et_tt1      jsr tone_tick
            ldx ch
            inx
            cpx #5
            bne et_tt
            inc tail
            rts

hloop       db 0                ; кадр повтора из заголовка ($FF - нет)
hlooph      db 0
ltime       ds 4                ; secacc и secs при входе в кадр повтора (без таблицы)
ftok        db 0                ; 1 - таблица времени кадров построена
ftabpg      db 0                ; она с ftabpg:$FC (load_file: сразу за мелодией)
ftlim       db 0                ; и должна кончиться ниже ftlim:00
ftbank      db 0                ; банк окна для нее (за блоками v2; иначе MAINBANK)
ftx         db 0                ; ft_build: третий байт secacc
fev         db 0                ; ft_build: в кадре есть SPEED или TEMPO

; Секунды: каждый тик N / 7980 секунды
count_secs  lda secacc
            clc
            adc ntimer
            sta secacc
            bcc cs_1
            inc secacc+1
cs_1        lda secacc
            sec
            sbc #lo(7980)
            tax
            lda secacc+1
            sbc #hi(7980)
            bcc cs_2
            sta secacc+1
            stx secacc
            inc secs
            bne cs_2
            inc secs+1
cs_2        rts

; --- Таблица времени кадров ---
; С ftabpg:$FC - по 4 байта на кадр: secacc и secs, с которыми движок входит в
; кадр, если мелодия играет подряд с начала. Место выбирает load_file: сразу за
; мелодией; у v2 с блоками - в окне на банке ftbank за последним блоком (основная
; часть обычно занимает память до окна). Счет тот же, что в eng_tick:
; - SPEED и TEMPO строки берутся из всех каналов, при нескольких в строке -
;   последний (каналы разбираются по порядку);
; - строка - speed тиков, но не меньше одного (tick 1 >= speed); тик - N / 7980 с;
; - кадр кончается после строки с BREAK или JUMP; следующий для времени - по
;   порядку, куда бы ни вел JUMP. TEMPO 0 не учитывается.
; Строится после load_file и eng_start (указатели таблиц, число кадров), до
; игры: playing = 0. Портит переменные движка (кадр, строки, speed, ntimer,
; время) - второй eng_start ставит их заново. Не помещается ниже ftlim:00 -
; ftok = 0: время, как раньше, идет от начала игры.
; По строкам кадра: BUF - тиков из SPEED (0 - нет), TSBUF - N из TEMPO (0 - нет);
; после load_file оба свободны
fbrk        equ brkf            ; ft_build: строк кадра до BREAK/JUMP включительно
fsn         equ str             ; ft_build: тиков строки * N

fb_r        rts                 ; не помещается: ftok = 0 (load_file)
ft_build    lda framesh         ; 4 * кадров байт с ftabpg:$FC - ниже ftlim:00?
            cmp #$40
            bcs fb_r
            lda frames
            asl a
            sta t0
            lda framesh
            rol a
            asl t0
            rol a
            tax
            lda t0
            clc
            adc #$FC
            txa
            adc ftabpg
            bcs fb_r
            cmp ftlim
            bcs fb_r
            lda #$FC
            sta bufp
            lda ftabpg
            sta bufp+1
            ldx #0
            txa
            sta ftx
fb_z        sta BUF,x
            sta TSBUF,x
            inx
            bne fb_z
            ; от eng_start: кадр 0, время 0, speed и ntimer из заголовка
fb_frame    ldy ftbank          ; время входа в кадр (окно - на банк таблицы)
            sta MAPWIN,y
            sty curbank
            ldy #3
fb_w        lda secacc,y
            sta (bufp),y
            dey
            bpl fb_w
            lda bufp
            clc
            adc #4
            sta bufp
            bcc fb_w1
            inc bufp+1
fb_w1       lda frame
            ldy frameh
            jsr frame_ptr
            ldy #0
            lda (zt),y
            sta frows
            sta fbrk
            sty ch
            sty fev
            ; каналы: SPEED и TEMPO - в BUF/TSBUF по строкам, BREAK и JUMP - fbrk
fb_ch       ldy ch
            jsr pat_ptr
            tay
            sta MAPWIN,y
            sty curbank
            lda #0
            sta row
            tay                 ; Y - смещение в паттерне
fb_row      lda row
            cmp frows
            bcs fb_nch
fb_cmd      lda (tmp16),y       ; fb_get без вызова: здесь проходит каждый байт
            iny
            bne fb_c1
            inc tmp16+1
fb_c1       cmp #$80
            bcs fb_term
            cmp #$62
            bcc fb_cmd          ; нота, $60, $61
            cmp #$64
            bcs fb_fx
            jsr fb_get          ; параметр $62 и $63
            bcc fb_cmd          ; C = 0: fb_get его не трогает
fb_fx       sbc #$64            ; C = 1
            tax
            jsr fb_get          ; параметр эффекта X
            cpx #10
            bcc fb_cmd          ; 0-9 - эффекты канала, на время не влияют
            beq fb_spd
            cpx #11
            beq fb_tmp
            cpx #12
            beq fb_brk
            cpx #16
            bne fb_cmd
fb_brk      ldx row             ; BREAK, JUMP: кадр кончится после этой строки
            inx
            cpx fbrk
            bcs fb_cmd
            stx fbrk
            bcc fb_cmd
fb_spd      ldx row
            cmp #1              ; тиков - не меньше одного
            bcs fb_s1
            lda #1
fb_s1       sta BUF,x
            sta fev
            jmp fb_cmd
fb_tmp      cmp #1              ; TEMPO 0 не учитывается
            bcc fb_cmd
            ldx row
            sta TSBUF,x
            sta fev
            jmp fb_cmd
fb_term     and #$7F            ; конец строки и пропуск
            sec
            adc row
            sta row
            bcc fb_row          ; за 255 - канал кончился
fb_nch      inc ch
            lda ch
            cmp #8
            beq fb_rows
            jmp fb_ch
fb_rows
            ; строки до BREAK/JUMP (fbrk <= frows): время (ftx:secacc) += тиков * N
            jsr fb_sn
            lda fev
            bne fb_slow
            ; SPEED и TEMPO в кадре нет: += fbrk * fsn, сдвигами (не больше 2^24)
            lda fbrk
            sta t0
            lda #0
            sta t1              ; fsn, t1 - 24 бита
fb_m        lsr t0
            bcc fb_m1
            lda secacc
            clc
            adc fsn
            sta secacc
            lda secacc+1
            adc fsn+1
            sta secacc+1
            lda ftx
            adc t1
            sta ftx
fb_m1       asl fsn
            rol fsn+1
            rol t1
            lda t0
            bne fb_m
            beq fb_norm
fb_slow     ldx #0
fb_rl       cpx fbrk
            bcs fb_cl
            lda BUF,x
            ora TSBUF,x
            beq fb_add
            lda BUF,x
            beq fb_r1
            sta speed
fb_r1       lda TSBUF,x
            beq fb_r2
            sta ntimer
fb_r2       lda #0              ; BUF и TSBUF - пустые к следующему кадру
            sta BUF,x
            sta TSBUF,x
            jsr fb_sn
fb_add      lda secacc
            clc
            adc fsn
            sta secacc
            lda secacc+1
            adc fsn+1
            sta secacc+1
            bcc fb_a1
            inc ftx
fb_a1       inx
            bne fb_rl
fb_cl       cpx frows           ; после BREAK/JUMP строки не играются: только очистить
            bcs fb_norm
            lda #0
            sta BUF,x
            sta TSBUF,x
            inx
            bne fb_cl
fb_norm     lda secacc          ; по 7980 - в секунды (ftx станет 0)
            sec
            sbc #lo(7980)
            tax
            lda secacc+1
            sbc #hi(7980)
            tay
            lda ftx
            sbc #0
            bcc fb_next
            sta ftx
            sty secacc+1
            stx secacc
            inc secs
            bne fb_norm
            inc secs+1
            bne fb_norm
fb_next     inc frame
            bne fb_n1
            inc frameh
fb_n1       lda frame
            cmp frames
            lda frameh
            sbc framesh
            bcs fb_ok
            jmp fb_frame
fb_ok       inc ftok
            rts

; Байт паттерна (tmp16),Y и Y дальше; C не меняется
fb_get      lda (tmp16),y
            iny
            bne fg_1
            inc tmp16+1
fg_1        rts

; fsn = тиков строки (speed, не меньше одного) * ntimer
fb_sn       lda #0
            sta fsn
            sta fsn+1
            ldy speed
            bne fs_1
            iny
fs_1        lda fsn
            clc
            adc ntimer
            sta fsn
            bcc fs_2
            inc fsn+1
fs_2        dey
            bne fs_1
            rts

; --- Разбор строки канала ch (X = ch) ---
parse_ch    lda c_wait,x
            beq pc_go
            dec c_wait,x
            rts
pc_go       lda c_bank,x        ; паттерн канала - в окне?
            cmp curbank
            beq pc_bk
            sta curbank
            tay
            sta MAPWIN,y
pc_bk       cpx #5
            bcs pc_loop
            lda #0
            sta c_delay,x
            sta c_cutreq,x
pc_loop     jsr getb
            cmp #$80
            bcc pc_cmd
            and #$7F
            sta c_wait,x
            rts
pc_cmd      cmp #$60
            bcs pc_ctl
            cpx #5
            bcs pc_dnote
            sta c_pnote,x
            lda #1
            sta c_pend,x
            jmp pc_loop
pc_dnote    cpx #7
            bcs pc_loop
            sta d_pend-5,x
            jmp pc_loop
pc_ctl      cmp #$62
            bcc pc_offcut
            beq pc_instr
            cmp #$63
            beq pc_legato
            sec
            sbc #$64
            sta t0
            jsr getb
            sta t1
            jsr do_effect
            ldx ch
            jmp pc_loop
pc_instr    jsr getb
            cpx #5
            bcs pc_loop
            sta c_pins,x
            jmp pc_loop
pc_legato   jsr getb
            cpx #5
            bcs pc_dnote
            sta c_pnote,x
            lda #2
            sta c_pend,x
            jmp pc_loop
pc_offcut   cpx #5
            bcs pc_doff
            tay
            lda #0
            sta c_pend,x
            cpy #$60
            bne pc_cut
            lda c_state,x
            cmp #1
            bne pc_loop
            lda #2
            sta c_state,x
            lda #0
            sta c_regpos,x
            jmp pc_loop
pc_cut      lda #0
            sta c_state,x
            jsr reg_out
            jmp pc_loop
pc_doff     cpx #7
            bcs pc_jl
            lda #$FF
            sta d_pend-5,x
            lda d_preset-5,x
            jsr drum_out
pc_jl       jmp pc_loop

; --- Эффект t0 с параметром t1, канал X ---
do_effect   lda t0
            cmp #17
            bcs fx_none
            asl a
            tay
            lda fxtab+1,y
            pha
            lda fxtab,y
            pha
            lda t1
fx_none     rts

fxtab       dw fx_arp-1, fx_su-1, fx_sd-1, fx_porta-1, fx_vib-1, fx_det-1, fx_bus-1
            dw fx_trem-1, fx_delay-1, fx_cut-1, fx_speed-1, fx_tempo-1, fx_jump-1
            dw fx_text-1, fx_tr-1, fx_retrig-1, fx_break-1

fx_speed    sta speed
            rts
fx_tempo    sta ntimer
            jmp set_timer
fx_jump     sta jump            ; кадр 0-255
            lda #0
            sta jumph
            rts
fx_text     sta text
            inc textchg
            rts
fx_break    inc brkf
            rts
fx_arp      cpx #5
            bcs fx_r
            sta c_arpfx,x
fx_dirty    lda #1
            sta c_pdirty,x
fx_r        rts
fx_su       cpx #5
            bcs fx_r
            sta c_slide,x
            jmp fx_dirty
fx_sd       cpx #5
            bcs fx_r
            eor #$FF
            clc
            adc #1
            sta c_slide,x
            jmp fx_dirty
fx_porta    cpx #5
            bcs fx_r
            sta c_porta,x
            jmp fx_dirty
fx_vib      cpx #5
            bcs fx_r
            sta c_vibfx,x
            jmp fx_dirty
fx_det      cpx #5
            bcs fx_r
            sta c_det,x
            jmp fx_dirty
fx_bus      cpx #5
            bcs fx_r
            sta c_bus,x
            rts
fx_trem     cpx #5
            bcs fx_r
            sta c_trem,x
            lda #0
            sta c_tremph,x
            rts
fx_delay    cpx #5
            bcs fx_r
            sta c_delay,x
            rts
fx_cut      cpx #5
            bcs fx_r
            sta c_cutreq,x
            rts
fx_tr       cpx #5
            bcs fx_r
            sta c_trans,x
            jmp fx_dirty
fx_retrig   cpx #5
            bcs fx_r
            sta c_retrig,x
            lda #0
            sta c_retcnt,x
            rts

; --- Регистр канала X: писать только изменение ---
reg_out     cmp c_lreg,x
            beq ro_same
            sta c_lreg,x
            ldy regoff,x
            sta $C080,y
ro_same     rts

; --- Ударные (X = 5, 6) ---
drum_out    ldy regoff,x
            sta $C080,y
            rts

drum_prep   lda d_pend-5,x
            cmp #$FF
            beq dp_r
            and #$0F
            jsr drum_out
dp_r        rts

drum_hit    lda d_pend-5,x
            cmp #$FF
            beq dp_r
            and #$0F
            sta d_preset-5,x
            ora #$10
            jsr drum_out
            lda #$FF
            sta d_pend-5,x
            sta c_meter,x
            rts

; --- Указатель инструмента канала X в ip ---
set_ip      lda c_ins,x
            asl a
            tay
            lda (itabp),y
            sta ip
            iny
            lda (itabp),y
            clc
            adc #hi(YZ)
            sta ip+1
            rts

; --- Шаг макроса: Y - смещение макроса, A - позиция; A = значение, mpos ---
mstep       sty moff
            sta mpos
            tya
            clc
            adc mpos
            tay
            iny
            iny
            lda (ip),y
            sta mval
            ldy moff
            inc mpos
            lda mpos
            cmp (ip),y
            bcc ms_done
            iny
            lda (ip),y
            cmp #$FF
            bne ms_set
            dey
            lda (ip),y
            sec
            sbc #1
ms_set      sta mpos
ms_done     lda mval
            rts

; --- Включить ноту канала X ---
note_on     lda c_pins,x
            cmp #$FF
            beq no_1
            sta c_ins,x
            lda #$FF
            sta c_pins,x
no_1        jsr set_ip
            lda c_pnote,x
            sta c_note,x
            lda #0
            sta t2
            lda c_pnote,x
            asl a
            rol t2
            asl a
            rol t2
            asl a
            rol t2
            asl a
            rol t2
            sta t1
            lda c_pend,x
            cmp #2
            bne no_full
            lda c_state,x
            cmp #1
            bne no_full
            ; Лига: цель - новая нота; без PORTA - сразу
            lda t1
            sta c_tgtlo,x
            lda t2
            sta c_tgthi,x
            lda c_porta,x
            bne no_end
            lda t1
            sta c_curlo,x
            lda t2
            sta c_curhi,x
            jmp no_end
no_full     lda t1
            sta c_curlo,x
            sta c_tgtlo,x
            lda t2
            sta c_curhi,x
            sta c_tgthi,x
            lda #1
            sta c_state,x
            lda #0
            sta c_regpos,x
            sta c_arppos,x
            sta c_pitpos,x
            sta c_vibph,x
            sta c_arpph,x
            sta c_retcnt,x
            sta c_tremph,x
            ldy #9
            lda (ip),y
            sta c_vibcnt,x
            ldy #17
            lda (ip),y
            ora #$0F
            sta c_meter,x
no_end      lda #1
            sta c_pdirty,x
            lda #0
            sta c_pend,x
            lda c_cutreq,x
            beq no_2
            clc
            adc #1
no_2        sta c_cut,x
            rts

; --- Тик тонового канала ch ---
tone_tick   ldx ch
            lda c_pend,x
            beq tt_1
            lda c_delay,x
            clc
            adc #1
            cmp tick
            bne tt_1
            jsr note_on
tt_1        lda c_cut,x
            beq tt_2
            dec c_cut,x
            bne tt_2
            lda c_state,x
            cmp #1
            bne tt_2
            lda #2
            sta c_state,x
            lda #0
            sta c_regpos,x
tt_2        lda c_state,x
            bne tt_on
            rts
tt_on       jsr set_ip
            ; --- Регистр ---
            lda c_state,x
            cmp #1
            bne tt_rel
            lda c_retrig,x
            beq tt_nor
            inc c_retcnt,x
            lda c_retcnt,x
            cmp c_retrig,x
            bcc tt_nor
            lda #0
            sta c_retcnt,x
            sta c_regpos,x
tt_nor      ldy #13
            bne tt_mac
tt_rel      ldy #14
tt_mac      lda (ip),y
            tay
            lda c_regpos,x
            jsr mstep
            lda mpos
            sta c_regpos,x
            lda mval
            sta t0
            lda c_bus,x
            cmp #$FF
            beq tt_nobus
            and #$0F
            sta t1
            lda t0
            and #$30
            ora t1
            sta t0
tt_nobus    lda c_state,x
            cmp #1
            bne tt_noov
            lda c_trem,x
            beq tt_notr
            clc
            adc #1
            lsr a
            sta t1
            lda c_tremph,x
            cmp t1
            bcc tt_tr1
            lda t0
            and #$DF
            sta t0
tt_tr1      inc c_tremph,x
            lda c_tremph,x
            cmp c_trem,x
            bcc tt_notr
            lda #0
            sta c_tremph,x
tt_notr     lda c_retrig,x
            beq tt_noov
            sec
            sbc #1
            cmp c_retcnt,x
            bne tt_noov
            lda t0
            and #$EF
            sta t0
tt_noov     lda c_pend,x
            cmp #1
            bne tt_noprep
            lda t0
            and #$EF
            sta t0
tt_noprep   lda t0
            jsr reg_out
            ; --- Индикатор ---
            ldy #18
            lda (ip),y
            sta t1
            lda #0
            sta t2
            lda c_state,x
            cmp #1
            bne tt_mrel
            ldy #17
            lda (ip),y
            asl a
            asl a
            asl a
            asl a
            sta t2
            jmp tt_mdec
tt_mrel     asl t1
            asl t1
tt_mdec     lda c_meter,x
            sec
            sbc t1
            bcc tt_mfl
            cmp t2
            bcs tt_mst
tt_mfl      lda t2
tt_mst      sta c_meter,x
            ; --- Высота: если ничего не меняется - период тот же ---
            lda c_pdirty,x
            bne tp_go
            lda c_slide,x
            ora c_arpfx,x
            bne tp_go
            ldy #15
            lda (ip),y
            iny
            ora (ip),y
            bne tp_go
            lda c_curlo,x
            cmp c_tgtlo,x
            bne tp_go
            lda c_curhi,x
            cmp c_tgthi,x
            bne tp_go
            lda c_vibfx,x
            and #$0F
            bne tp_go
            lda c_vibfx,x
            bne tp_skip         ; вибрато эффекта без глубины
            ldy #11
            lda (ip),y
            bne tp_go
tp_skip     rts
tp_go       lda #0
            sta c_pdirty,x
            ; --- Высота: PORTA ---
            lda c_curlo,x
            cmp c_tgtlo,x
            bne tp_p
            lda c_curhi,x
            cmp c_tgthi,x
            beq tp_nop
tp_p        lda c_curlo,x
            cmp c_tgtlo,x
            lda c_curhi,x
            sbc c_tgthi,x
            bcs tp_down
            lda c_curlo,x
            clc
            adc c_porta,x
            sta c_curlo,x
            bcc tp_u1
            inc c_curhi,x
tp_u1       lda c_tgtlo,x
            cmp c_curlo,x
            lda c_tgthi,x
            sbc c_curhi,x
            bcs tp_nop
            bcc tp_set
tp_down     lda c_curlo,x
            sec
            sbc c_porta,x
            sta c_curlo,x
            bcs tp_d1
            dec c_curhi,x
tp_d1       lda c_curlo,x
            cmp c_tgtlo,x
            lda c_curhi,x
            sbc c_tgthi,x
            bcs tp_nop
tp_set      lda c_tgtlo,x
            sta c_curlo,x
            lda c_tgthi,x
            sta c_curhi,x
tp_nop      ; --- Скольжение и макрос высоты: и высота, и цель ---
            lda c_slide,x
            beq tp_nosl
            jsr add_cur
tp_nosl     ldy #16
            lda (ip),y
            beq tp_nopit
            tay
            lda c_pitpos,x
            jsr mstep
            lda mpos
            sta c_pitpos,x
            lda mval
            jsr add_cur
tp_nopit    ; --- Полутоны: макрос арпеджио, ARP, транспозиция ---
            lda #0
            sta t3
            ldy #15
            lda (ip),y
            beq ar_nom
            tay
            lda c_arppos,x
            jsr mstep
            lda mpos
            sta c_arppos,x
            lda mval
            sta t3
ar_nom      lda c_arpfx,x
            beq ar_nofx
            ldy c_arpph,x
            beq ar_ph
            dey
            bne ar_2
            lsr a
            lsr a
            lsr a
            lsr a
            bpl ar_add
ar_2        and #$0F
ar_add      clc
            adc t3
            sta t3
ar_ph       inc c_arpph,x
            lda c_arpph,x
            cmp #3
            bcc ar_nofx
            lda #0
            sta c_arpph,x
ar_nofx     lda t3
            clc
            adc c_trans,x
            ; tot = cur + полутоны * 16
            sta t1
            lda #0
            sta t2
            lda t1
            bpl ar_pos
            dec t2
ar_pos      asl t1
            rol t2
            asl t1
            rol t2
            asl t1
            rol t2
            asl t1
            rol t2
            lda c_curlo,x
            clc
            adc t1
            sta tot
            lda c_curhi,x
            adc t2
            sta tot+1
            ; --- Вибрато ---
            lda c_vibfx,x
            bne vb_fx
            ldy #10
            lda (ip),y
            sta t1
            iny
            lda (ip),y
            sta t2
            jmp vb_go
vb_fx       pha
            lsr a
            lsr a
            lsr a
            lsr a
            sta t1
            pla
            and #$0F
            sta t2
vb_go       lda #0
            sta vibv
            lda t2
            beq vb_done
            lda c_vibcnt,x
            beq vb_run
            dec c_vibcnt,x
            jmp vb_done
vb_run      lda c_vibph,x
            clc
            adc t1
            and #$3F
            sta c_vibph,x
            lda t2
            lsr a
            lsr a
            clc
            adc #hi(vibtab)
            sta zt+1
            lda t2
            and #3
            asl a
            asl a
            asl a
            asl a
            asl a
            asl a
            ora c_vibph,x
            sta zt
            ldy #0
            lda (zt),y
            sta vibv
vb_done     ; --- Расстройка инструмента, эффекта, вибрато ---
            ldy #12
            lda (ip),y
            jsr add_tot
            lda c_det,x
            jsr add_tot
            lda vibv
            jsr add_tot
            ; --- Период ---
            lda tot+1
            bpl pc_pos
            lda #0
            sta tot
            sta tot+1
            beq pc_ok
pc_pos      cmp #6
            bcc pc_ok
            lda #$FF
            sta tot
            lda #5
            sta tot+1
pc_ok       lda tot
            and #$0F
            sta t1
            lda tot+1
            sta t2
            lda tot
            lsr t2
            ror a
            lsr t2
            ror a
            lsr t2
            ror a
            lsr t2
            ror a
            tay
            lda div12,y
            sta oct
            lda mod12,y
            asl a
            asl a
            asl a
            asl a
            ora t1
            tay
            lda ptab_lo,y
            sta per
            lda ptab_hi,y
            sta per+1
            ldy oct
            beq pc_wr
            lda per
            clc
            adc rnd_lo,y
            sta per
            lda per+1
            adc rnd_hi,y
            sta per+1
pc_sh       lsr per+1
            ror per
            dey
            bne pc_sh
pc_wr       lda per
            cmp c_lperlo,x
            bne pc_do
            lda per+1
            cmp c_lperhi,x
            beq pc_end
pc_do       lda per
            sta c_lperlo,x
            ldy cntoff,x
            sta $C080,y
            lda per+1
            sta c_lperhi,x
            sta $C080,y
pc_end      rts

; A (со знаком) прибавить к высоте и цели канала X, с границами 0..1535
add_cur     sta t1
            lda #0
            sta t2
            lda t1
            bpl ac_1
            dec t2
ac_1        lda c_curlo,x
            clc
            adc t1
            sta c_curlo,x
            lda c_curhi,x
            adc t2
            sta c_curhi,x
            lda c_tgtlo,x
            clc
            adc t1
            sta c_tgtlo,x
            lda c_tgthi,x
            adc t2
            sta c_tgthi,x
            ; границы
            lda c_curhi,x
            bpl ac_c1
            lda #0
            sta c_curlo,x
            sta c_curhi,x
ac_c1       cmp #6
            bcc ac_c2
            lda #$FF
            sta c_curlo,x
            lda #5
            sta c_curhi,x
ac_c2       lda c_tgthi,x
            bpl ac_c3
            lda #0
            sta c_tgtlo,x
            sta c_tgthi,x
ac_c3       cmp #6
            bcc ac_c4
            lda #$FF
            sta c_tgtlo,x
            lda #5
            sta c_tgthi,x
ac_c4       rts

; A (со знаком) прибавить к tot
add_tot     ora #0
            bmi at_neg
            clc
            adc tot
            sta tot
            bcc at_r
            inc tot+1
at_r        rts
at_neg      clc
            adc tot
            sta tot
            bcs at_r
            dec tot+1
            rts
