; SPDX-License-Identifier: GPL-3.0-or-later
; Part of the YAZS Studio project: https://github.com/Ptr314/yazs-studio
;
; ЯЗС-плеер для Агата-9: меню мелодий .YZ на диске 840 КБ, движок формата
; (docs/FORMAT.md), пульт каналов на экране АЦР-32 и вид трекера на АЦР-64.
; Запускается «Быстропускалкой» V2.0 как единственный защищенный B-файл,
; RTS возвращает в ее меню. Прерывания не используются: SEI все время, такт -
; опрос флага таймера ячейки.
;
; Сборка: as65 -l -n -opalyer.bin player.a65 (build.py)

            include "gen_const.a65"

; --- Память ---
SCREEN      equ $1000           ; страница АЦР-32 / АЦР-64 (режимы $0A / $8A)
SONGLD      equ $3EFC           ; сюда грузится тело B-файла (4 байта ДОС + .YZ)
YZ          equ $3F00           ; начало .YZ; смещения файла + YZ = адреса
SONGTOP     equ $C0             ; страница, выше которой мелодия не помещается
; .YZ v2: блоки по 8 КБ - в банках 8-15 (верхние 64 КБ ОЗУ), видны в окне
; сегмента 5; при ДОС блоков нет - в этих банках она и ее буферы. Диспетчер
; памяти: запись в $C1SB - сегменту S банк B
WINDOW      equ $A000
WINPG       equ $A0             ; страницы окна $A0-$BF (hi() в AS65 берет все выражение)
WINEND      equ $C0
MAPWIN      equ $C150           ; + банк: окно $A000-$BFFF на этот банк
MAINBANK    equ 5               ; свой банк сегмента 5 (основная память)
; Резидентная часть ДОС (запуск по BRUN) - $0300-$0FFF: векторы $03D0-$03FF,
; заглушки $0400-$04FF, таблица ЧЗТС $0557, код $0600-$0FFF (его вызывает ДОС
; из банков 8-9). $0300-$05FF плеер не трогает; $0600-$0FFF при ДОС на время
; работы переносится в DOSSAVE, у «Быстропускалки» там остатки загрузчика
ZPSAVE      equ $0600
BUF         equ $0700           ; сектор каталога
TSBUF       equ $0800           ; список T/S
DIRTAB      equ $0B00           ; 40 файлов по 32 байта: дорожка и сектор списка, имя
MAXFILES    equ 40
DOSVEC      equ $03D0           ; ДОС: JMP $048B
DOSTAB      equ $0557           ; таблица ЧЗТС: тип $01, слот * 16, привод, том, дорожка, сектор
; Основная память Бейсика-А9: страница $1800-$18FF - его переходники (их зовут и
; Бейсик, и ДОС), программа - с $1901. Файл ЯЗС-ПЛЕЕР грузится с $4000
; (loader.a65): загрузчик кладет страницу $18 в SAVE18 и тело плеера - на $1800
SAVE18      equ $B500           ; копия $1800-$18FF (ставит loader.a65)
DOSSAVE     equ $B600           ; копия $0600-$0FFF при ДОС (10 страниц, до $BFFF)
DOSSAVEPG   equ $B5             ; мелодия при ДОС - ниже этой страницы

; --- Нулевая страница (вся сохраняется и восстанавливается) ---
zt          equ $02             ; указатели
ip          equ $04
scr         equ $06
bufp        equ $08
str         equ $0A
t0          equ $0C
t1          equ $0D
t2          equ $0E
t3          equ $0F
tick        equ $10
speed       equ $11
row         equ $12
frows       equ $13
frame       equ $14
frames      equ $15
loopf       equ $16
jump        equ $17
brkf        equ $18
text        equ $19
ended       equ $1A
ntimer      equ $1B
card        equ $1C             ; слот ЯЗС * 16
fdc         equ $1D             ; слот контроллера 840 * 16
tcnt        equ $1E             ; счетчик тиков (2) - для проверки по yazs.irqs
patp        equ $20             ; указатели паттернов каналов 0-7 (16)
ch          equ $30
ch2         equ $31
tot         equ $32             ; высота (2)
per         equ $34             ; период (2)
oct         equ $36
mpos        equ $37
moff        equ $38
mval        equ $39
vibv        equ $3A
ordp        equ $3C             ; адрес таблицы кадров (2)
ptabp       equ $3E             ; таблица паттернов (2)
itabp       equ $40             ; таблица инструментов (2)
ttabp       equ $42             ; таблица подписей (2)
ltrk        equ $44             ; диск: логическая дорожка, сектор, текущий цилиндр
lsec        equ $45
curcyl      equ $46
tcyl        equ $47
retry       equ $48
tries       equ $49
csum        equ $4A
tolo        equ $4B
tohi        equ $4C
nfiles      equ $4D
sel         equ $4E
key         equ $4F
view        equ $50             ; 0 - пульт, 1 - трекер
playall     equ $51
uistep      equ $52
secacc      equ $53             ; накопитель секунд (2)
secs        equ $55             ; прошло секунд (2)
textchg     equ $57
tail        equ $58             ; тиков звучания после конца
cur         equ $59             ; номер играющего файла
rdtries     equ $5A
flash       equ $5B
tmp16       equ $5C             ; (2)
dirp        equ $5E             ; (2)
col         equ $60
attr        equ $61
lastframe   equ $62
lastrow     equ $63
nstr        equ $64             ; (4) буфер числа
tsidx       equ $68
cattrk      equ $69
catsec      equ $6A
keyrep      equ $6B
uirow       equ $6C
uich        equ $6D
upage       equ $6E
mtop        equ $6F
playing     equ $76
idle        equ $77             ; (2)
idlemin     equ $79             ; (2)
idletick    equ $7B             ; (2)
framesh     equ $7D             ; v2: старшие байты числа кадров, кадра, повтора, перехода
frameh      equ $7E
loopfh      equ $7F             ; $FF - повтора нет
jumph       equ $80             ; $FF - перехода нет
yzver       equ $81             ; версия .YZ
curbank     equ $82             ; какой банк сейчас в окне
lmainpg     equ $83             ; загрузка: страница конца основной части; $FF - блоков нет
lblk        equ $84             ; загрузка: банк блока, который грузится (0 - основная часть)
lblkend     equ $85             ; загрузка: банк после последнего блока

; --- Переменные каналов ($0900-$0A5F) ---
; c_lreg, c_lperlo, c_lperhi читает studio/verify.py: перенос - поправить и там
c_ins       equ $0900           ; по 8 байт: каналы 0-4 (тоны), 5-6 ударные
c_pend      equ $0908
c_pnote     equ $0910
c_pins      equ $0918
c_delay     equ $0920
c_cut       equ $0928
c_cutreq    equ $0930
c_state     equ $0938
c_regpos    equ $0940
c_arppos    equ $0948
c_pitpos    equ $0950
c_curlo     equ $0958
c_curhi     equ $0960
c_tgtlo     equ $0968
c_tgthi     equ $0970
c_porta     equ $0978
c_slide     equ $0980
c_arpfx     equ $0988
c_arpph     equ $0990
c_vibfx     equ $0998
c_vibcnt    equ $09A0
c_vibph     equ $09A8
c_det       equ $09B0
c_bus       equ $09B8
c_trem      equ $09C0
c_tremph    equ $09C8
c_trans     equ $09D0
c_retrig    equ $09D8
c_retcnt    equ $09E0
c_lreg      equ $09E8
c_lperlo    equ $09F0
c_lperhi    equ $09F8
c_meter     equ $0A00
c_note      equ $0A08
c_wait      equ $0A10           ; 8 каналов
c_uins      equ $0A18           ; показанный инструмент (экран)
c_unote     equ $0A20           ; показанная нота
c_ureg      equ $0A28           ; показанный регистр
c_umeter    equ $0A30
d_pend      equ $0A38           ; ударные 5, 6 (индекс канала - 5)
d_preset    equ $0A3A
regoff      equ $0A40           ; card + 8 + канал (8 байт)
cntoff      equ $0A48           ; card + адрес счетчика тона (5)
c_pdirty    equ $0A50           ; высоту пересчитать
c_bank      equ $0A58           ; банк паттерна канала (8 каналов)

            org $1800

; === Вход ===================================================================

; Запускают «Быстропускалка» (единственный защищенный файл диска) или ДОС
; (BRUN из Бейсика): обе - через JSR, выход - RTS к ним
start       php
            sei
            ; Регистры - вернуть как были: ДОС вызывает плеер из ввода строки
            ; (GETLN), и RTS приходит прямо в Бейсик - X там длина строки (0)
            sta savea
            stx savex
            sty savey
            ; ДОС в памяти: вектор $03D0 - JMP в ее заглушки $04xx, таблица ЧЗТС
            ; типа $01. Узнать до любой записи в $0600-$0FFF
            ldx #0
            lda DOSVEC
            cmp #$4C
            bne st_dos
            lda DOSVEC+2
            cmp #$04
            bne st_dos
            lda DOSTAB
            cmp #$01
            bne st_dos
            inx
st_dos      stx dosmode
            txa
            beq st_nod
            jsr dos_save
st_nod      ldx #0
sv_zp       lda $00,x
            sta ZPSAVE,x
            inx
            bne sv_zp
            tsx
            stx savesp
            ; Слот контроллера: при ДОС - из ее таблицы, у «Быстропускалки» - в $F6;
            ; иначе 5. Предел мелодии и блоки v2: при ДОС - до DOSSAVE, без блоков
            ldx #SONGTOP
            ldy #9
            lda dosmode
            beq st_lim
            ldx #DOSSAVEPG
            ldy #1
st_lim      stx songtop
            sty blkmax
            lda $F6
            ldx dosmode
            beq st_slot
            lda DOSTAB+1
st_slot     and #$70
            cmp #$10
            bcs st_fdcok
            lda #$50
st_fdcok    sta fdc
            lda #$10            ; ЯЗС по умолчанию в слоте 1
            sta card
            jsr card_init
            lda #0
            sta view
            sta sel
            sta playall
            sta playing
            jsr scan_disk
main_menu   jsr menu
            ; A: 0 - выход, 1 - играть sel
            beq quit
            jsr play_file
            jmp main_menu

quit        jsr card_off
            jsr clrscr          ; пустой текстовый экран (COUT при ДОС нельзя: она еще в BRUN)
            lda dosmode         ; ДОС считает, что головка на ее последней дорожке
            beq qt_1
            jsr dsk_on
            bcs qt_1
            jsr dsk_recal
            bcs qt_1
            lda DOSTAB+4
            sta ltrk
            jsr dsk_seek
qt_1        jsr dsk_off
            jsr map_main
            ldx #0
rs_zp       lda ZPSAVE,x
            sta $00,x
            inx
            bne rs_zp
            sta $C058           ; палитра 1 (экран - АЦР-32 с $1000: clrscr)
            sta $C05A
            lda dosmode
            beq qt_ret
            jmp dos_exit        ; вне страницы $18: она возвращается Бейсику
            ; «Быстропускалка»: RTS - она перечитает каталог и запустит единственный
            ; защищенный файл (плеер) снова, а с другим диском - его программу или меню
qt_ret      ldx savesp
            txs
            lda savea
            ldx savex
            ldy savey
            plp
            rts

savesp      db 0
savea       db 0                ; регистры на входе
savex       db 0
savey       db 0
dosmode     db 0                ; 1 - запущен из ДОС (BRUN)
songtop     db SONGTOP          ; страница, с которой мелодия не помещается
blkmax      db 9                ; блоков .YZ v2 не больше blkmax - 1 (при ДОС - 0)

; Резидентная часть ДОС $0600-$0FFF <-> DOSSAVE. Без нулевой страницы: восстановление
; идет уже после нее. 10 страниц, их адреса - в самих командах копирования
dos_save    lda #$06
            ldx #hi(DOSSAVE)
            bne dsv_go
dos_restore lda #hi(DOSSAVE)
            ldx #$06
dsv_go      sta dsv_r+2
            stx dsv_w+2
            ldx #10
dsv_p       ldy #0
dsv_r       lda $0600,y
dsv_w       sta DOSSAVE,y
            iny
            bne dsv_r
            inc dsv_r+2
            inc dsv_w+2
            dex
            bne dsv_p
            rts

; === Ячейка =================================================================

; Сначала стоп счета и прерываний (после включения счетчики ВИ53 стоят в
; случайных режимах), режим 3 всем шести счетчикам, тишина в каналах, такт
card_init   ldy card
            lda #$C0
            sta $C08F,y
            lda #$36
            sta $C083,y
            lda #$76
            sta $C083,y
            lda #$B6
            sta $C083,y
            lda #$36
            sta $C087,y
            lda #$76
            sta $C087,y
            lda #$B6
            sta $C087,y
            ldx #0
ci_cnt      lda cntraw,x
            clc
            adc card
            tay
            lda #$E8            ; 1000 - тон без звука (канал выключен)
            sta $C080,y
            lda #$03
            sta $C080,y
            inx
            cpx #5
            bne ci_cnt
            ; Смещения регистров каналов
            ldx #0
ci_off      txa
            clc
            adc #8
            adc card
            sta regoff,x
            inx
            cpx #8
            bne ci_off
            ldx #0
ci_coff     lda cntraw,x
            clc
            adc card
            sta cntoff,x
            inx
            cpx #5
            bne ci_coff
            jsr card_silence
            lda #80
            sta ntimer
            jsr set_timer
            ldy card
            lda #$40            ; счет и прерывание таймера разрешены, внешнее - нет
            sta $C08F,y
            lda #$80            ; сброс флага (команда защелки счетчика 2)
            sta $C087,y
            rts

cntraw      db 0,1,2,4,5

; Окно $A000-$BFFF - на основную память (банк 5)
map_main    ldy #MAINBANK
            sta MAPWIN,y
            sty curbank
            rts

card_silence
            ldy card
            lda #0
            ldx #7
cs_l        sta $C088,y
            iny
            dex
            bne cs_l
            rts

card_off    jsr card_silence
            ldy card
            lda #$C0
            sta $C08F,y
            lda #$80
            sta $C087,y
            rts

set_timer   ldy card
            lda ntimer
            sta $C086,y
            lda #0
            sta $C086,y
            rts

; Во время долгой работы с экраном: если флаг таймера взведен - сыграть тик.
; Движок портит временные ячейки - они сохраняются. Только при playing
poll_tick   pha
            lda playing
            beq pk_r1
            tya
            pha
            ldy card
            lda $C080,y
            bpl pk_r2
            lda #$80
            sta $C087,y
            txa
            pha
            ldx #13
pk_s        lda zt,x            ; zt, ip, scr, bufp, str, t0-t3
            sta pksave,x
            dex
            bpl pk_s
            lda tmp16
            sta pksave+14
            lda tmp16+1
            sta pksave+15
            jsr eng_tick
            ldx #13
pk_l        lda pksave,x
            sta zt,x
            dex
            bpl pk_l
            lda pksave+14
            sta tmp16
            lda pksave+15
            sta tmp16+1
            pla
            tax
pk_r2       pla
            tay
pk_r1       pla
            rts

pksave      ds 16

; Ждать флаг таймера и сбросить его. Пока ждем - кусочек работы экрана
; idle - проходы ожидания с прошлого тика (по 22 такта), idlemin - наименьшее
; за мелодию: запас времени тика; 0 - тик не уложился
wait_tick   ldy card
            lda $C080,y
            bmi wt_got
            inc idle
            bne wait_tick
            inc idle+1
            bne wait_tick
wt_got      lda #$80
            sta $C087,y
            lda tcnt+1          ; первая секунда - статичный экран, не в счет
            bne wt_cmp
            lda tcnt
            cmp #100
            bcc wt_r
wt_cmp      lda idle+1
            cmp idlemin+1
            bcc wt_min
            bne wt_r
            lda idle
            cmp idlemin
            bcs wt_r
wt_min      lda idle
            sta idlemin
            lda idle+1
            sta idlemin+1
            lda tcnt
            sta idletick
            lda tcnt+1
            sta idletick+1
wt_r        lda #0
            sta idle
            sta idle+1
            rts

            include "engine.a65"
            include "disk.a65"
            include "ui.a65"
            include "gen_tables.a65"

; Выход в ДОС. Код - в последней странице тела, вне $1800-$18FF: здесь она
; снова становится переходниками Бейсика.
; - $0600-$0FFF (ZPSAVE там больше не нужен) - на место;
; - страницы плеера $19 - до этой - нулями: с $1901 у Бейсика программа, код
;   плеера он принял бы за ее строки (NEW и ввод строк - «синт. ошибка»);
; - страница $18 - на место;
; - теплый перезапуск $03D0: ДОС закончит BRUN и вернет в Бейсик. RTS привел бы
;   прямо в Бейсик, а ДОС осталась бы «внутри» BRUN, и следующее обращение к ней
;   ушло бы по старому стеку
dos_exit    jsr dos_restore
            lda #0
            ldx #$19
dx_p        stx dx_w+2
            ldy #0
dx_w        sta $1900,y
            iny
            bne dx_w
            inx
            cpx #hi(dos_exit)
            bne dx_p
            ldx savesp          ; savesp - в странице $18: прочитать до нее
            txs
            ldy #0
dx_1        lda SAVE18,y
            sta $1800,y
            iny
            bne dx_1
            plp
            jmp DOSVEC

