; SPDX-License-Identifier: GPL-3.0-or-later
; Part of the YAZS Studio project: https://github.com/Ptr314/yazs-studio
;
; Вид «трекер»: АЦР-64 (один байт на знак, 64 знака в строке), страница кадра
; по строкам: ноты и инструменты пяти тонов, пресеты ударных. Страница (28
; строк кадра) рисуется по кускам, по одному за тик: очистка по 4 строки,
; потом по каналу, - так тик движка не опаздывает. Указатель «>» идет по
; строкам; на ударах вспыхивает палитра (зеленая -> белая).

TRK_ROWS    equ 28              ; строк кадра на странице
TRK_TOP     equ 3               ; первая строка экрана

trkphase    equ $70             ; 0 - готово, 1..7 - очистка, 8..14 - каналы
trkframe    equ $71
trkpage     equ $72
trkmark     equ $73             ; где стоит указатель
trkflash    equ $74
trkcol      equ $75
trkframeh   equ $86

trk_draw    sta $C78A           ; АЦР-64, $1000
            sta $C05B           ; палитра 3: зеленая
            sta $C058
            lda #$80            ; строки и числа (putx) - по байту на знак
            sta scr64
            lda #lo(SCREEN)
            sta zt
            lda #hi(SCREEN)
            sta zt+1
            ldx #8
td_0        ldy #0
            lda #$A0
td_1        sta (zt),y
            iny
            bne td_1
            jsr poll_tick
            inc zt+1
            dex
            bne td_0
            ; заголовок
            ldx #0
            ldy #0
            jsr at64
            lda #lo(s_header)
            ldy #hi(s_header)
            jsr print
            ldx #0
            ldy #32
            jsr at64
            lda #lo(YZ+4)
            sta str
            lda #hi(YZ+4)
            sta str+1
            ldx #30
            jsr putn
            ldx #2
            ldy #0
            jsr at64
            lda #lo(s_trkcols)
            ldy #hi(s_trkcols)
            jsr print
            ldx #31
            ldy #0
            jsr at64
            lda #lo(s_playhelp)
            ldy #hi(s_playhelp)
            jsr print
            ldx #1
            ldy #32
            jsr at64
            lda #lo(s_playhelp2)
            ldy #hi(s_playhelp2)
            jsr print
            lda #$FF
            sta trkframe
            sta trkframeh
            sta trkmark
            lda #0
            sta trkphase
            sta trkflash
            rts

; Курсор АЦР-64: X - строка, Y - колонка
at64        lda rowlo,x
            sta scr
            lda rowhi,x
            sta scr+1
            tya
            clc
            adc scr
            sta scr
            bcc a64_1
            inc scr+1
a64_1       rts

; Знаки - putc64 (ui.a65); строки и числа - общие print, putn, hex2, dec3, mmss:
; при scr64 они выводят через него

; --- Тик вида ---
trk_tick    ; новая страница?
            lda row
            ldx #0
tk_pg       cmp #TRK_ROWS
            bcc tk_pg1
            sbc #TRK_ROWS
            inx
            bne tk_pg
tk_pg1      sta t0              ; строка на странице
            lda frame
            cmp trkframe
            bne tk_new
            lda frameh
            cmp trkframeh
            bne tk_new
            cpx trkpage
            beq tk_cont
tk_new      lda frame
            sta trkframe
            lda frameh
            sta trkframeh
            stx trkpage
            lda #1
            sta trkphase
            lda #$FF
            sta trkmark
tk_cont     lda trkphase
            beq tk_mark
            cmp #8
            bcs tk_chan
            ; очистка 4 строк страницы
            sec
            sbc #1
            asl a
            asl a
            clc
            adc #TRK_TOP
            sta t1
            lda #4
            sta t2
tk_cl       ldx t1
            ldy #0
            jsr at64
            ldy #63
            lda #$A0
tk_cl1      sta (scr),y
            dey
            bpl tk_cl1
            ; номер строки кадра (hex): + TRK_ROWS за каждую страницу до этой;
            ; строки за концом кадра - без номера
            lda t1
            sec
            sbc #TRK_TOP
            ldx trkpage
            beq tk_cl3
tk_cl2      clc
            adc #TRK_ROWS
            bcs tk_cl4          ; за 255 - кадр короче
            dex
            bne tk_cl2
tk_cl3      cmp frows
            bcs tk_cl4
            sta t3
            ldx t1
            ldy #0
            jsr at64
            lda t3
            jsr hex2
tk_cl4      inc t1
            dec t2
            bne tk_cl
            jmp tk_adv
            ; Разбор портит t0 (frame_ptr кладет туда кадр), а по t0 дальше ставится
            ; указатель: строка вне 0..27 уводила at64 за таблицы rowlo/rowhi, и
            ; запись шла в $C1xx (диспетчер памяти) или $C7xx (режим экрана)
tk_chan     tax
            lda t0              ; строка на странице
            pha
            txa
            sec
            sbc #8
            jsr trk_decode
            pla
            sta t0
tk_adv      inc trkphase
            lda trkphase
            cmp #15
            bcc tk_mark
            lda #0
            sta trkphase
tk_mark     ; указатель строки
            lda t0
            cmp trkmark
            beq tk_info
            lda trkmark
            cmp #$FF
            beq tk_m1
            clc
            adc #TRK_TOP
            tax
            ldy #3
            jsr at64
            lda #$A0
            jsr putc64
tk_m1       lda t0
            sta trkmark
            clc
            adc #TRK_TOP
            tax
            ldy #3
            jsr at64
            lda #$BE            ; >
            jsr putc64
tk_info     ; кадр и время в строке 1, раз в 8 тиков
            lda tick
            and #7
            bne tk_fl
            ldx #1
            ldy #0
            jsr at64
            lda #$EB            ; К
            jsr putc64
            lda #$A0
            jsr putc64
            lda yzver
            cmp #2
            bcs tk_f5
            lda frame
            jsr dec3
            jmp tk_f6
tk_f5       jsr frame_dec       ; v2: пять цифр
            ldx #0
tk_f7       lda numbuf,x
            jsr putc64
            inx
            cpx #5
            bne tk_f7
tk_f6
            lda #$A0
            jsr putc64
            jsr putc64
            lda secs
            sta tmp16
            lda secs+1
            sta tmp16+1
            jsr mmss
tk_fl       ; вспышка на ударах
            lda c_meter+5
            cmp #$FF
            beq tk_hit
            lda c_meter+6
            cmp #$FF
            bne tk_fl1
tk_hit      lda #$E0
            sta c_meter+5
            sta c_meter+6
            sta $C05A           ; палитра 1: белая
            sta $C058
            lda #4
            sta trkflash
            rts
tk_fl1      lda trkflash
            beq tk_r
            dec trkflash
            bne tk_r
            sta $C05B
            sta $C058
tk_r        rts

; Канал A страницы trkframe/trkpage: разобрать паттерн с начала кадра. Паттерн
; v2 может лежать в блоке: окно - на его банк (движок вернет свой сам)
trk_decode  sta trkcol
            lda trkframe
            ldy trkframeh
            jsr frame_ptr
            ldy trkcol
            jsr pat_ptr
            tay
            sta MAPWIN,y
            sty curbank
            lda tmp16
            sta str
            lda tmp16+1
            sta str+1
            ldy #0
            lda (zt),y
            sta t3              ; строк в кадре
            ; первая строка страницы
            lda trkpage
            ldx #0
            stx t2              ; строка кадра
            tax
            lda #0
dc_pg       cpx #0
            beq dc_pg1
            clc
            adc #TRK_ROWS
            dex
            jmp dc_pg
dc_pg1      sta t1              ; первая строка страницы
dc_row      lda t2
            cmp t3
            bcc dc_cmd
            rts
            ; команды строки t2
dc_cmd      ldy #0
            lda (str),y
            inc str
            bne dc_2
            inc str+1
dc_2        cmp #$80
            bcc dc_2a
            jmp dc_term
dc_2a
            cmp #$60
            bcc dc_note
            cmp #$62
            bcc dc_off
            beq dc_ins
            cmp #$63
            beq dc_leg
            jsr dc_skip         ; эффект: пропустить параметр
            jmp dc_cmd
dc_ins      ldy #0
            lda (str),y
            sta mval            ; инструмент - показать рядом с нотой
            jsr dc_skip
            lda trkcol
            cmp #5
            bcs dc_cmd
            ldx #5
            jsr dc_at
            bcs dc_cmd
            lda mval
            jsr hex2
            jmp dc_cmd
dc_leg      ldy #0
            lda (str),y
            jsr dc_skip
            pha
            ldx #0
            jsr dc_at
            pla
            bcs dc_cmd
            jsr dc_putnote
            lda #$DE            ; ^ - лига
            jsr putc64
            jmp dc_cmd
dc_note     pha
            ldx #0
            jsr dc_at
            pla
            bcs dc_cmd
            ldx trkcol
            cpx #5
            bcs dc_dr
            jsr dc_putnote
            jmp dc_cmd
dc_dr       jsr hex2
            jmp dc_cmd
dc_off      pha
            ldx #0
            jsr dc_at
            pla
            bcs dc_jc
            cmp #$60
            bne dc_cut
            lda #$BD            ; ===
            bne dc_o3
dc_cut      lda #$DE            ; ^^^
dc_o3       sta t0
            jsr putc64
            lda t0
            jsr putc64
            lda trkcol
            cmp #5
            bcs dc_jc
            lda t0
            jsr putc64
dc_jc       jmp dc_cmd
dc_term     and #$7F
            sec
            adc t2              ; строка + 1 + пропуск
            sta t2
            jmp dc_row
dc_end      rts

dc_skip     inc str
            bne dsk_1
            inc str+1
dsk_1       rts

; Курсор на строку t2 канала trkcol, смещение X в колонке; C = 1 - не на странице
dc_at       lda t2
            sec
            sbc t1
            bcc dca_no
            cmp #TRK_ROWS
            bcs dca_no
            clc
            adc #TRK_ROWS-TRK_ROWS+TRK_TOP
            stx t0
            tax
            ldy trkcol
            lda trkx,y
            clc
            adc t0
            tay
            jsr at64
            clc
            rts
dca_no      sec
            rts

; Нота A: «C#4»
dc_putnote  tay
            lda div12,y
            pha
            lda mod12,y
            asl a
            tay
            lda notenm,y
            sty t0
            jsr putc64
            ldy t0
            lda notenm+1,y
            jsr putc64
            pla
            ora #$B0
            jmp putc64

trkx        db 5,14,23,32,41,51,56
