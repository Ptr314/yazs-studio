; SPDX-License-Identifier: GPL-3.0-or-later
; Part of the YAZS Studio project: https://github.com/Ptr314/yazs-studio
;
; Вариант C: трекерный движок, собранный под набор мелодий игры. Здесь - сборка
; для мелодий без эффектов (как у Alice): кадры, паттерны, инструменты RLE,
; периоды из словаря игры, только занятые каналы. Остальные возможности движка
; добавляются условной сборкой из варианта A (trk_full.a65).
; Данные мелодии (за JSR): [N, если YZ_HDR_N], число кадров, кадры подряд:
; строк кадра и по слову на занятый канал - адрес паттерна.
; Паттерн - как в .YZ, но нота - индекс словаря периодов, инструмент - номер в
; таблице игры: $00-$5F нота, $62 i инструмент, $80+n конец строки и n пустых.

yzplay      pla
            sta yzp
            pla
            sta yzp+1
            php
            sei
    if YZ_HDR_N
            ldy #1
            lda (yzp),y
            iny
    else
            lda #YZ_N
            ldy #1
    endif
            jsr yz_start
            lda (yzp),y         ; число кадров
            sta nfr
            iny
            tya                 ; fp = yzp + Y: первый кадр
            clc
            adc yzp
            sta fp
            lda yzp+1
            adc #0
            sta fp+1
            jsr ch_init
            lda #0
            sta tick
            sta ended
            sta tail
            jsr load_frame

ct_tick     jsr yz_wait
            lda ended
            bne ct_tail
            lda tick
            bne ct_ton
            ldx #0
ct_p        jsr parse
            inx
            inx
            cpx #2*NCH
            bne ct_p
ct_ton      ldx #0
ct_t        jsr tone
            inx
            inx
            cpx #2*NCH
            bne ct_t
            inc tick
            lda tick
            cmp #YZ_SPEED
            bcc ct_tick
            lda #0
            sta tick
            inc row
            lda row
            cmp frows
            bcc ct_tick
            dec nfr
            beq ct_end
            jsr load_frame
            jmp ct_tick
ct_end      inc ended
            bne ct_tick
ct_tail
    if YZ_TAIL
            jsr tail_tick
            bcc ct_tick
    endif
            jmp yz_exit

; --- Кадр с fp: строк и адреса паттернов; fp - на следующий ---
load_frame  ldy #0
            lda (fp),y
            sta frows
            ldx #0
lf_ch       iny
            lda (fp),y
            sta chp,x
            iny
            lda (fp),y
            sta chp+1,x
            lda #0
            sta c_wait,x
            inx
            inx
            cpx #2*NCH
            bne lf_ch
            tya
            sec
            adc fp
            sta fp
            bcc lf_r
            inc fp+1
lf_r        lda #0
            sta row
            rts

; --- Байт паттерна канала X ---
getb        lda (chp,x)
            inc chp,x
            bne gb_r
            inc chp+1,x
gb_r        rts

; --- Разбор строки канала X ---
parse       lda c_wait,x
            beq pa_go
            dec c_wait,x
            rts
pa_go       jsr getb
            cmp #$80
            bcc pa_cmd
            and #$7F
            sta c_wait,x
            rts
pa_cmd      cmp #$60
            bcs pa_ins
            sta c_note,x
            lda #2
            sta c_pend,x
            bne pa_go
pa_ins      jsr getb            ; $62 i
            sta c_pins,x
            jmp pa_go
